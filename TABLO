
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Numaralı Tablo</title>

    <style>
        body {
            font-family: Arial, sans-serif;
        }

        table {
            width: 400px;
            height: 200px;
            border: 2px solid #555;
            padding: 3px;
            table-layout: fixed;
        }

        td {
            border: 2px solid #555;
            text-align: center;
            vertical-align: middle;
            font-size: 25px;
            padding: 2px;
        }

        .beyaz {
            background-color: white;
        }

        .kirmizi {
            background-color: red;
        }

        .mor {
            background-color: #ad20e8;
        }

        .sari {
            background-color: yellow;
        }
    </style>
</head>

<body>

<table>
    <tr>
        <td class="beyaz">1</td>
        <td class="beyaz" colspan="3">2</td>
    </tr>

    <tr>
        <td class="beyaz" rowspan="3">3</td>
        <td class="kirmizi">4</td>
        <td class="mor">5</td>
        <td class="kirmizi" rowspan="2">6</td>
    </tr>

    <tr>
        <td class="kirmizi">7</td>
        <td class="mor">8</td>
    </tr>

    <tr>
        <td class="sari" colspan="2">9</td>
        <td class="mor">10</td>
    </tr>
</table>

</body>
</html>
